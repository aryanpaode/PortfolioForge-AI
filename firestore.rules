rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner(uid) { return verified() && request.auth.uid == uid; }
    // No unauthenticated cross-account reads or writes. Email verification is enforced
    // here, not merely by hiding a Compose button. Legacy paths are kept readable.
    match /users/{uid}/{document=**} {
      allow read, write: if owner(uid);
    }
    match /publicPortfolios/{slug} {
      // Public profiles are deliberately public only after the user confirms Publish.
      // Disable collection listing; fetching an explicitly shared profile is allowed.
      allow get: if true;
      allow list: if false;
      allow create: if verified()
                    && slug == 'portfolio-' + request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.items is list
                    && request.resource.data.skills is list;
      allow update: if verified()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.items is list
                    && request.resource.data.skills is list;
      allow delete: if verified() && resource.data.ownerUid == request.auth.uid;
    }
    // Everything else is denied by default.
  }
}
